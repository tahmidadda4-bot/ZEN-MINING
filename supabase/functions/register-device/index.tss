import {corsHeaders} from '../_shared/cors.ts';import {serviceClient,userClient} from '../_shared/db.ts';
async function sha256(value:string){const b=new TextEncoder().encode(value);const h=await crypto.subtle.digest('SHA-256',b);return Array.from(new Uint8Array(h)).map(x=>x.toString(16).padStart(2,'0')).join('')}
Deno.serve(async req=>{if(req.method==='OPTIONS')return new Response('ok',{headers:corsHeaders});try{const auth=userClient(req);const u=(await auth.auth.getUser()).data.user;if(!u)throw new Error('Unauthorized');const b=await req.json();if(!b.deviceFingerprint||!b.deviceName)throw new Error('deviceFingerprint and deviceName are required');const db=serviceClient();const {data:existing}=await db.from('devices').select('*').eq('device_fingerprint',b.deviceFingerprint).maybeSingle();if(existing&&existing.user_id!==u.id)throw new Error('Device already registered to another user');const {data:cfg}=await db.from('mining_configs').select('global_enabled,global_rate').limit(1).single();const monitorToken=`zm_${crypto.randomUUID()}_${crypto.randomUUID().replaceAll('-','')}`;const tokenHash=await sha256(monitorToken);let data,error;if(existing){({data,error}=await db.from('devices').update({device_name:b.deviceName,model:b.model??null,android_version:b.androidVersion??null,app_version:b.appVersion??null,status:'online',last_seen_at:new Date().toISOString(),monitor_token_hash:tokenHash,updated_at:new Date().toISOString()}).eq('id',existing.id).select().single());}else{({data,error}=await db.from('devices').insert({user_id:u.id,device_fingerprint:b.deviceFingerprint,device_name:b.deviceName,model:b.model??null,android_version:b.androidVersion??null,app_version:b.appVersion??null,status:'online',last_seen_at:new Date().toISOString(),monitor_token_hash:tokenHash,mining_status:'inactive',mining_rate:Number(cfg?.global_rate??5),mining_started_at:null,mining_ends_at:null,last_reward_at:null}).select().single());}if(error)throw error;return Response.json({device:data,monitorToken},{headers:corsHeaders})}catch(e){return Response.json({error:String(e)},{status:400,headers:corsHeaders})}});
